{
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Identifiant du membre concern\u00e9 par l'anomalie de d\u00e9p\u00f4t"
    },
    "user_email": {
      "type": "string",
      "description": "E-mail du membre concern\u00e9"
    },
    "user_name": {
      "type": "string",
      "description": "Nom complet du membre concern\u00e9"
    },
    "status": {
      "type": "string",
      "description": "Statut du dossier d'examen",
      "enum": [
        "pending_review",
        "anomaly_confirmed",
        "commissions_released",
        "claim_refused"
      ],
      "default": "pending_review"
    },
    "first_tx_id": {
      "type": "string",
      "description": "Identifiant de la transaction du premier d\u00e9p\u00f4t de 3 000 FCFA"
    },
    "first_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence du premier paiement (LeekPay)"
    },
    "first_amount_fcfa": {
      "type": "number",
      "description": "Montant du premier paiement"
    },
    "first_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date du premier d\u00e9p\u00f4t"
    },
    "first_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de confirmation r\u00e9elle du premier paiement"
    },
    "second_tx_id": {
      "type": "string",
      "description": "Identifiant de la transaction du deuxi\u00e8me d\u00e9p\u00f4t de 3 000 FCFA"
    },
    "second_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence du deuxi\u00e8me paiement (LeekPay)"
    },
    "second_amount_fcfa": {
      "type": "number",
      "description": "Montant du deuxi\u00e8me paiement"
    },
    "second_date": {
      "type": "string",
      "format": "date-time",
      "description": "Date du deuxi\u00e8me d\u00e9p\u00f4t"
    },
    "second_confirmed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de confirmation r\u00e9elle du deuxi\u00e8me paiement"
    },
    "sponsor_chain": {
      "type": "string",
      "description": "Arbre de parrainage du membre (JSON : niveaux 1 \u00e0 3)"
    },
    "commission_preview": {
      "type": "string",
      "description": "Commissions qui auraient normalement \u00e9t\u00e9 g\u00e9n\u00e9r\u00e9es (JSON : niveau, b\u00e9n\u00e9ficiaire, montant)"
    },
    "blocked_levels": {
      "type": "string",
      "description": "Rappel des commissions bloqu\u00e9es (N1/N2/N3 \u2014 COMMISSION_BLOCKED_REVIEW)"
    },
    "decided_by": {
      "type": "string",
      "description": "E-mail de l'administrateur ayant examin\u00e9 le dossier"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de la d\u00e9cision d'examen"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notes d'examen de l'administrateur"
    },
    "refund_note": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence ou modalit\u00e9s du remboursement / traitement du deuxi\u00e8me paiement"
    },
    "refunded_by": {
      "type": "string",
      "description": "E-mail de l'administrateur ayant trait\u00e9 le deuxi\u00e8me paiement"
    },
    "refunded_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date du traitement du deuxi\u00e8me paiement"
    }
  },
  "required": [
    "user_id",
    "user_email",
    "status",
    "first_tx_id",
    "second_tx_id"
  ],
  "name": "DepositReview",
  "type": "object",
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}