{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "username": {
      "type": "string",
      "description": "Nom d'utilisateur unique (3 \u00e0 20 caract\u00e8res : lettres, chiffres, _ ou .)"
    },
    "first_name": {
      "type": "string",
      "description": "Pr\u00e9nom de l'utilisateur"
    },
    "last_name": {
      "type": "string",
      "description": "Nom de l'utilisateur"
    },
    "country": {
      "type": "string",
      "description": "Code pays (ISO 3166-1 alpha-2) s\u00e9lectionn\u00e9 \u00e0 l'inscription",
      "enum": [
        "CI",
        "TG",
        "BJ",
        "BF",
        "CM",
        "SN",
        "CG",
        "CD"
      ]
    },
    "phone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone au format international (E.164)"
    },
    "email_verified": {
      "type": "boolean",
      "description": "E-mail v\u00e9rifi\u00e9 : par code OTP \u00e0 l'inscription, ou par proc\u00e9dure manuelle journalis\u00e9e (distincte de la preuve technique)",
      "default": false
    },
    "unsubscribed": {
      "type": "boolean",
      "description": "D\u00e9sabonn\u00e9 des communications promotionnelles",
      "default": false
    },
    "account_status": {
      "type": "string",
      "description": "Statut du compte",
      "enum": [
        "active",
        "suspended"
      ],
      "default": "active"
    },
    "referral_code": {
      "type": "string",
      "description": "Code de parrainage personnel (unique, g\u00e9n\u00e9r\u00e9 c\u00f4t\u00e9 serveur)"
    },
    "referred_by": {
      "type": "string",
      "description": "Identifiant de l'utilisateur parrain \u2014 d\u00e9fini une seule fois \u00e0 l'inscription, non modifiable ensuite"
    },
    "blocked_reason": {
      "type": "string",
      "description": "Motif administratif du blocage du compte"
    },
    "blocked_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date et heure de la d\u00e9cision de blocage"
    },
    "blocked_by": {
      "type": "string",
      "description": "E-mail de l'administrateur ayant pris la d\u00e9cision de blocage"
    },
    "access_activated": {
      "type": "boolean",
      "description": "Acc\u00e8s Pro activ\u00e9 apr\u00e8s confirmation r\u00e9elle du premier d\u00e9p\u00f4t de 3 000 FCFA (frais d'acc\u00e8s, non retirable)",
      "default": false
    },
    "access_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'activation de l'acc\u00e8s Pro"
    },
    "initial_deposit_status": {
      "type": "string",
      "description": "Indicateur du d\u00e9p\u00f4t initial \u00e9ligible (3 000 FCFA) : NOT_PAID (aucun d\u00e9p\u00f4t), PENDING (paiement en attente de confirmation serveur), CONFIRMED (premier d\u00e9p\u00f4t confirm\u00e9 \u2014 commissions d'affiliation g\u00e9n\u00e9r\u00e9es une seule fois), REVIEW_REQUIRED (double d\u00e9p\u00f4t d\u00e9tect\u00e9 \u2014 commissions bloqu\u00e9es en attente d'examen)",
      "enum": [
        "NOT_PAID",
        "PENDING",
        "CONFIRMED",
        "REVIEW_REQUIRED"
      ],
      "default": "NOT_PAID"
    },
    "share_contacts": {
      "type": "boolean",
      "description": "Consentement explicite au partage de ses coordonn\u00e9es dans l'annuaire des membres \u2014 retirable \u00e0 tout moment depuis le profil",
      "default": false
    },
    "marketplace_banned": {
      "type": "boolean",
      "description": "Bannissement d\u00e9finitif de la Marketplace (vente et achat interdits) prononc\u00e9 par l'administration apr\u00e8s v\u00e9rification",
      "default": false
    },
    "marketplace_banned_reason": {
      "type": "string",
      "description": "Motif du bannissement Marketplace"
    },
    "marketplace_banned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date du bannissement Marketplace"
    },
    "marketplace_banned_by": {
      "type": "string",
      "description": "E-mail de l'administrateur ayant prononc\u00e9 le bannissement Marketplace"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}