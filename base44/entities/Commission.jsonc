{
  "properties": {
    "commission_ref": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence unique de la commission (CMS-\u2026)"
    },
    "transaction_id": {
      "type": "string",
      "description": "Identifiant de la transaction de vente Marketplace \u00e0 l'origine de la commission \u2014 une m\u00eame vente ne peut g\u00e9n\u00e9rer qu'une seule commission par niveau"
    },
    "order_id": {
      "type": "string",
      "description": "Identifiant de la commande Marketplace concern\u00e9e"
    },
    "transaction_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence de la commande Marketplace \u00e0 l'origine de la commission"
    },
    "beneficiary_id": {
      "type": "string",
      "description": "Identifiant du b\u00e9n\u00e9ficiaire (parrain)"
    },
    "beneficiary_email": {
      "type": "string",
      "description": "E-mail du b\u00e9n\u00e9ficiaire"
    },
    "source_user_id": {
      "type": "string",
      "description": "Identifiant de l'acheteur (membre du r\u00e9seau) dont l'achat a d\u00e9clench\u00e9 la commission"
    },
    "source_user_email": {
      "type": "string",
      "description": "E-mail du filleul concern\u00e9"
    },
    "level": {
      "type": "number",
      "description": "Niveau d'affiliation (1, 2 ou 3 \u2014 jamais au-del\u00e0)",
      "enum": [
        1,
        2,
        3
      ]
    },
    "amount_fcfa": {
      "type": "number",
      "description": "Montant en FCFA, en pourcentage du prix de vente (Niveau 1 : 3 %, Niveau 2 : 1,5 %, Niveau 3 : 0,5 %)"
    },
    "status": {
      "type": "string",
      "description": "Statut de la commission (confirmed = cr\u00e9dit\u00e9e au portefeuille, blocked = bloqu\u00e9e en attente d'examen, cancelled = annul\u00e9e apr\u00e8s d\u00e9cision administrative)",
      "enum": [
        "confirmed",
        "blocked",
        "cancelled"
      ],
      "default": "confirmed"
    }
  },
  "required": [
    "transaction_id",
    "beneficiary_id",
    "level",
    "amount_fcfa",
    "status"
  ],
  "name": "Commission",
  "type": "object",
  "rls": {
    "read": {
      "$or": [
        {
          "data.beneficiary_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}