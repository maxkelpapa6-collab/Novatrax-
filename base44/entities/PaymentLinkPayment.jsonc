{
  "name": "PaymentLinkPayment",
  "type": "object",
  "properties": {
    "payment_ref": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence unique du paiement (PLP-\u2026)"
    },
    "link_id": {
      "type": "string",
      "description": "Identifiant du lien de paiement concern\u00e9"
    },
    "link_name": {
      "type": "string",
      "description": "Nom du lien au moment du paiement"
    },
    "link_image": {
      "type": "string",
      "description": "Photo du lien au moment du paiement"
    },
    "amount_fcfa": {
      "type": "number",
      "description": "Montant pay\u00e9 par le payeur en FCFA"
    },
    "commission_fcfa": {
      "type": "number",
      "description": "Commission NOVATRAX (10 % du montant) pr\u00e9lev\u00e9e automatiquement"
    },
    "net_fcfa": {
      "type": "number",
      "description": "Montant net (90 %) cr\u00e9dit\u00e9 au cr\u00e9ateur apr\u00e8s confirmation du paiement"
    },
    "payer_name": {
      "type": "string",
      "description": "Nom facultatif fourni par le payeur"
    },
    "creator_id": {
      "type": "string",
      "description": "Identifiant du membre cr\u00e9ateur qui re\u00e7oit le paiement"
    },
    "creator_email": {
      "type": "string",
      "description": "E-mail du cr\u00e9ateur"
    },
    "checkout_id": {
      "type": "string",
      "description": "Identifiant du checkout LeekPay (v\u00e9rification serveur)"
    },
    "checkout_url": {
      "type": "string",
      "description": "URL de paiement LeekPay du paiement"
    },
    "payment_reference": {
      "type": "string",
      "description": "R\u00e9f\u00e9rence PLP- unique du paiement"
    },
    "status": {
      "type": "string",
      "description": "Statut du paiement : awaiting_payment (en attente), completed (confirm\u00e9 \u2014 cr\u00e9ateur cr\u00e9dit\u00e9), cancelled (\u00e9chou\u00e9 ou abandonn\u00e9, aucun d\u00e9bit)",
      "enum": [
        "awaiting_payment",
        "completed",
        "cancelled"
      ],
      "default": "awaiting_payment"
    },
    "credited_transaction_id": {
      "type": "string",
      "description": "Identifiant de la transaction portefeuille cr\u00e9ditant le cr\u00e9ateur (\u00e9criture unique par paiement)"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date de confirmation r\u00e9elle du paiement par le prestataire"
    }
  },
  "required": [
    "payment_ref",
    "link_id",
    "amount_fcfa",
    "commission_fcfa",
    "net_fcfa",
    "creator_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.creator_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}