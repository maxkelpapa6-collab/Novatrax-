# Copiez ce fichier en .env puis remplissez les valeurs.

# Adresse publique du site (sans / final). Sert aux liens des e-mails,
# aux retours de paiement et aux webhooks LeekPay.
APP_URL=https://www.votre-domaine.com
PORT=3000

# Base de données MongoDB
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB=novatrax

# Clé secrète des sessions : 64 caractères aléatoires.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Code demandé une seule fois pour désigner l'administrateur principal.
ADMIN_SETUP_CODE=

# Paiements LeekPay
LEEKPAY_SECRET_KEY=

# E-mails (codes de vérification, notifications). Sans SMTP_HOST, les
# e-mails sont seulement affichés dans la console du serveur.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=NOVATRAX

# Dossier des fichiers envoyés (images, APK)
UPLOAD_DIR=./data/uploads
